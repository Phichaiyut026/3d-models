[configuration]

entry_symbol = "astral_library_init"
compatibility_minimum = "4.4"
reloadable = false

[libraries]

macos.debug = "res://bin/libastral.macos.template_debug.framework"
macos.release = "res://bin/libastral.macos.template_release.framework"
windows.debug.x86_64 = "res://bin/libastral.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libastral.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libastral.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libastral.linux.template_release.x86_64.so"
